diff --git a/packages/ltx-kernels/csrc/sycl_r8/Makefile b/packages/ltx-kernels/csrc/sycl_r8/Makefile
new file mode 100644
index 0000000..ad80fe3
--- /dev/null
+++ b/packages/ltx-kernels/csrc/sycl_r8/Makefile
@@ -0,0 +1,52 @@
+# R8/R9A/R10D SYCL kernels — Level-Zero interop build.
+#
+# Device kernels are compiled to SPIR-V; the host side is plain C++ (NO -fsycl)
+# and launches them on torch's own in-order XPU queue (see r8_host.cpp).
+#
+# The compiler MUST ship libsycl.so.8 so it matches the runtime torch links
+# (oneAPI 2025.x). `compiler/latest` is usually a newer major (libsycl.so.9) and
+# will not match. Autodetect the right compiler dir; override with CC_DIR or
+# ONEAPI_ROOT.
+REPO ?= $(abspath $(CURDIR)/../../../../..)
+VENV := $(REPO)/.venv
+
+CC_DIR ?= $(shell for d in $${ONEAPI_ROOT:-/opt/intel/oneapi}/compiler/*; do \
+    [ -e "$$d/lib/libsycl.so.8" ] && echo "$$d" && break; done)
+ifeq ($(strip $(CC_DIR)),)
+$(error no oneAPI compiler shipping libsycl.so.8 found; set CC_DIR or ONEAPI_ROOT)
+endif
+
+ICPX     := $(CC_DIR)/bin/icpx
+BUNDLER  := $(CC_DIR)/bin/compiler/clang-offload-bundler
+POSTLINK := $(CC_DIR)/bin/compiler/sycl-post-link
+TOSPIRV  := $(CC_DIR)/bin/compiler/llvm-spirv
+
+TORCH_INC := $(shell $(VENV)/bin/python -c "import torch,os;print(os.path.join(os.path.dirname(torch.__file__),'include'))")
+TORCH_LIB := $(shell $(VENV)/bin/python -c "import torch,os;print(os.path.join(os.path.dirname(torch.__file__),'lib'))")
+PY_INC    := $(shell $(VENV)/bin/python -c "import sysconfig;print(sysconfig.get_paths()['include'])")
+
+# Host: plain C++ (no -fsycl), against the venv SYCL headers matching libsycl.so.8.
+HOSTFLAGS := -O2 -fPIC -std=c++17 -DSYCL_DISABLE_FSYCL_SYCLHPP_WARNING \
+  -I$(TORCH_INC) -I$(TORCH_INC)/torch/csrc/api/include \
+  -I$(PY_INC) -I$(VENV)/include -I.
+HOSTLINK := -shared \
+  -L$(VENV)/lib -L$(TORCH_LIB) -lsycl -lze_loader \
+  -ltorch -ltorch_cpu -ltorch_xpu -ltorch_python -lc10 -lc10_xpu \
+  -Wl,-rpath,$(VENV)/lib -Wl,-rpath,$(TORCH_LIB)
+
+all: libr8_sycl.so
+
+r8_kernels.spv: r8_device.cpp r8_args.h
+	$(ICPX) -fsycl -fsycl-targets=spir64 -O2 -std=c++17 -c r8_device.cpp -o r8_device.o
+	$(BUNDLER) -unbundle -input=r8_device.o -output=r8_dev.bc -type=o -targets=sycl-spir64-unknown-unknown
+	$(POSTLINK) --ir-output-only --spec-const=emulation -o r8_p.bc r8_dev.bc
+	$(TOSPIRV) -o r8_kernels.spv r8_p.bc
+
+libr8_sycl.so: r8_host.cpp r8_args.h r8_kernels.spv
+	$(ICPX) $(HOSTFLAGS) r8_host.cpp -o $@ $(HOSTLINK)
+
+clean:
+	rm -f libr8_sycl.so r8_device.o r8_dev.bc r8_dev.spv r8_dev.table r8_dev_0.ll
+	rm -f r8_p.bc r8_kernels.spv r8_back.ll r8_back.err r8b.table r8b_0.ll r8c.table r8c_0.ll
+
+.PHONY: all clean
diff --git a/packages/ltx-kernels/csrc/sycl_r8/bench_r8.py b/packages/ltx-kernels/csrc/sycl_r8/bench_r8.py
